# ──────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (default)
# ──────────────────────────────────────────────────────────

# Database - Docker PostgreSQL (run: docker compose up -d)
DATABASE_URL=postgresql://medrecords:medrecords@localhost:5432/medrecords

# Auth session secret (min 32 chars)
NUXT_SESSION_PASSWORD=this-is-a-dev-secret-change-in-production-min32chars

# Storage: "local" saves files to ./uploads, "r2" uses Cloudflare R2
STORAGE_DRIVER=local

# AI Provider: "codex" (default), "claude", or "openai"
AI_PROVIDER=codex

# OpenAI API config (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o

# ──────────────────────────────────────────────────────────
# PRODUCTION (uncomment and fill when deploying)
# ──────────────────────────────────────────────────────────

# Database - Neon PostgreSQL
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Storage
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=medical-reports
# R2_PUBLIC_URL=https://your-r2-public-url.com

# Nitro preset for deployment platform
# NITRO_PRESET=vercel
